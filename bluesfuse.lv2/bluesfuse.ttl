#
# Port blocks keep index/symbol/name before any scalePoint: the
# stom-pi-builder modgui generator splits port blocks on "]".

@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://dataforte.stom-pi#me>
    a foaf:Person ;
    foaf:name "Dataforte" .

<http://dataforte.stom-pi/plugins/bluesfuse>
    a doap:Project ;
    doap:maintainer <http://dataforte.stom-pi#me> ;
    doap:name "BluesFuse Preamp" .

<http://dataforte.stom-pi/plugins/bluesfuse>
    a lv2:Plugin ,
        lv2:DistortionPlugin ;
    doap:maintainer <http://dataforte.stom-pi#me> ;
    doap:name "BluesFuse Preamp" ;
    doap:license <https://www.gnu.org/licenses/gpl-2.0> ;
    lv2:project <http://dataforte.stom-pi/plugins/bluesfuse> ;
    lv2:optionalFeature lv2:hardRTCapable ;

    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;

rdfs:comment """

Faust-based emulation of the Xotic BB Preamp overdrive, covering the five
variants traced by Aion FX in 2021: BB Preamp 1.5 (current), BB-AT (Andy
Timmons / pre-2007), Bass BB Preamp, and the Custom Shop Comp and MB.

Signal path (component values from the trace schematics):
    BJT input buffer -> Tube Screamer style clipper (diodes in the op-amp
    feedback) -> TS tone stage -> inverting gain stage (VOLUME gang B)
    -> 2-band Baxandall EQ -> VOLUME gang A -> BJT output buffer.
The linear stages are exact nodal-analysis solutions of the circuit.

Controls:
    GAIN    drive (1M pot in the clipper feedback)
    VOLUME  dual-gang: output level and pre-EQ gain stage
    TREBLE  Baxandall treble, +-17 dB (noon = flat)
    BASS    Baxandall bass, +-19 dB (noon = flat)
    MID     Custom Shop MB tone pot; 2 (9 o'clock) = stock BB voicing
    COMP    Custom Shop Comp switch: AT (1 diode) / Off (lift) / 1.5 (2 diodes)
    MODEL   Guitar or Bass BB component set

Reference: Aion FX, "Tracing Journal: Xotic BB Preamp (five variants)",
https://aionfx.com/news/tracing-journal-xotic-bb-preamp-five-variants/

""";

    lv2:port [
        a lv2:InputPort ,
            lv2:ControlPort ;
        lv2:index 0 ;
        lv2:symbol "gain" ;
        lv2:name "GAIN";
        lv2:default 5.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:InputPort ,
            lv2:ControlPort ;
        lv2:index 1 ;
        lv2:symbol "volume" ;
        lv2:name "VOLUME";
        lv2:default 5.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:InputPort ,
            lv2:ControlPort ;
        lv2:index 2 ;
        lv2:symbol "treble" ;
        lv2:name "TREBLE";
        lv2:default 5.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:InputPort ,
            lv2:ControlPort ;
        lv2:index 3 ;
        lv2:symbol "bass" ;
        lv2:name "BASS";
        lv2:default 5.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:InputPort ,
            lv2:ControlPort ;
        lv2:index 4 ;
        lv2:symbol "mid" ;
        lv2:name "MID";
        lv2:default 2.0 ;
        lv2:minimum 0.0 ;
        lv2:maximum 10.0 ;
    ] , [
        a lv2:InputPort ,
            lv2:ControlPort ;
        lv2:index 5 ;
        lv2:symbol "comp" ;
        lv2:name "COMP";
        lv2:default 2 ;
        lv2:minimum 0 ;
        lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "AT (1 diode)" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Off (lift)" ; rdf:value 1 ] ;
        lv2:scalePoint [ rdfs:label "1.5 (2 diodes)" ; rdf:value 2 ] ;
    ] , [
        a lv2:InputPort ,
            lv2:ControlPort ;
        lv2:index 6 ;
        lv2:symbol "model" ;
        lv2:name "MODEL";
        lv2:default 0 ;
        lv2:minimum 0 ;
        lv2:maximum 1 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "Guitar" ; rdf:value 0 ] ;
        lv2:scalePoint [ rdfs:label "Bass" ; rdf:value 1 ] ;
    ] , [
        a lv2:AudioPort ,
            lv2:OutputPort ;
        lv2:index 7 ;
        lv2:symbol "out" ;
        lv2:name "Out" ;
    ] , [
        a lv2:AudioPort ,
            lv2:InputPort ;
        lv2:index 8 ;
        lv2:symbol "in" ;
        lv2:name "In" ;
    ] .
